{
  "md3": {<* for name, color in colors *>
    "{{ name }}": "{{ color.default.hex }}"<* if {{ loop.last }} *><* else *>,<* endif *><* endfor *>
  },
  "role": {
    "hover": "{{ colors.surface_container_highest.default.hex }}",
    "chip": "{{ colors.surface_container_high.default.hex }}",
    "track": "{{ colors.surface_container_highest.default.hex }}",
    "panel": "{{ colors.surface_container.default.hex }}",
    "raised": "{{ colors.surface_container_highest.default.hex }}",
    "sunken": "{{ colors.surface_container_lowest.default.hex }}",
    "muted": "{{ colors.on_surface_variant.default.hex }}",
    "border": "{{ colors.outline_variant.default.hex }}",
    "ink": "{{ colors.on_surface.default.hex }}",
    "accent": "{{ colors.primary.default.hex }}",
    "accentFill": "{{ colors.primary_container.default.hex }}",
    "accentOnFill": "{{ colors.on_primary_container.default.hex }}"
  },
  "palette": {<* for name, palette in palettes *><* for shade, color in palette *>
    "{{ name }}{{ shade }}": "{{ color.hex }}"<* if {{ loop.last }} *><* else *>,<* endif *><* endfor *><* if {{ loop.last }} *><* else *>,<* endif *><* endfor *>
  },
  "base16": {<* for name, color in base16 *>
    "{{ name }}": "{{ color.default.hex }}"<* if {{ loop.last }} *><* else *>,<* endif *><* endfor *>
  },

  "wallpaper": "{{ image }}"
}
